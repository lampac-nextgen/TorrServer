{
  "name": "torrserver_web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "gsap": "^3.15.0",
    "hls.js": "1.7.4",
    "i18next": "^26.6.0",
    "i18next-browser-languagedetector": "^8.2.4",
    "lucide-react": "^1.66.0",
    "media-chrome": "^4.19.4",
    "parse-torrent": "^11.0.24",
    "parse-torrent-title": "^3.0.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-i18next": "^17.1.10",
    "sonner": "^2.0.8"
  },
  "scripts": {
    "i18n:check": "node scripts/i18n-check.mjs",
    "gen:palettes": "node scripts/gen-palettes.mjs",
    "palettes:new": "node scripts/new-palette.mjs",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project=mock",
    "test:e2e:real": "playwright test --project=real",
    "test:e2e:live": "playwright test --project=live",
    "test:e2e:palettes": "playwright test --project=palettes",
    "palettes:report": "node scripts/palettes-report.mjs",
    "test:e2e:shots": "playwright test --project=screenshots",
    "test:e2e:ui": "playwright test --project=mock --ui",
    "verify": "yarn typecheck && yarn lint && yarn test && yarn i18n:check && yarn test:e2e",
    "verify:full": "yarn verify && yarn test:e2e:real",
    "preview": "vite preview",
    "lint": "eslint src e2e scripts --color",
    "fix": "eslint src e2e scripts --fix --color"
  },
  "browserslist": {
    "production": [
      "chrome >= 117",
      "firefox >= 121",
      "safari >= 17",
      "edge >= 121",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/outfit": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/parse-torrent": "^11.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "opentype.js": "2.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "description": "TorrServer web client",
  "license": "GPL-3.0"
}
